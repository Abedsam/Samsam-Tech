# Vorlage für die Datei .env auf dem Server (nie ins Git-Repo hochladen!)
# Geheime Werte erzeugen mit:  npm run setup -- "DeinSicheresPasswort"

# --- Grundeinstellungen ---
SITE_NAME=Samsam-Tech
PORT=3000
TRUST_PROXY=1
PUBLIC_BASE_URL=https://api.samsam-tech.de
ALLOWED_ORIGINS=https://samsam-tech.de,https://www.samsam-tech.de
DATA_DIR=/var/lib/samsam-api
RETENTION_DAYS=180

# --- Aus `npm run setup` übernehmen ---
DATA_KEY=
ADMIN_USER=abed
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
SIPGATE_WEBHOOK_TOKEN=

# --- WhatsApp (Meta Cloud API) ---
# Aus developers.facebook.com → deine App → WhatsApp → API-Einrichtung
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Deine eigene Handynummer, an die die Hinweise gehen (nur Ziffern mit Ländervorwahl)
WA_TO=49
# Leer lassen zum Testen; für den Dauerbetrieb Namen der freigegebenen Vorlage eintragen
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=de

# --- Anrufe ---
# missed = nur verpasste Anrufe melden, all = jeden eingehenden Anruf sofort melden
CALL_NOTIFY_ON=missed

# --- Optional: zusätzlich Hinweis per E-Mail (IONOS) ---
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL_TO=
