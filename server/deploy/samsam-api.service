# /etc/systemd/system/samsam-api.service
# Startet den Server automatisch beim Hochfahren und nach Abstürzen neu.
[Unit]
Description=Samsam-Tech API (Kontaktformular & Anruf-Benachrichtigung)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=samsam
Group=samsam
WorkingDirectory=/opt/samsam-api/server
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

# Zusätzliche Absicherung
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/samsam-api

[Install]
WantedBy=multi-user.target
